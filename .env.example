# Copy to .env and adjust. Never commit real secrets.
#
# Generate a strong secret with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# When APP_ENV=production the backend and agent REFUSE TO START if any secret
# below is left at its insecure default (or PANEL_SECRET is shorter than 32).

# development | production
APP_ENV=development

# Postgres
POSTGRES_USER=steam
POSTGRES_PASSWORD=steam
POSTGRES_DB=steammanager

# Panel admin login
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Secrets — generate strong random values for production
JWT_SECRET=dev-jwt-secret-change-me
# Must be at least 32 chars; used to derive the Fernet key for Steam credentials
PANEL_SECRET=dev-panel-secret-change-me-32bytes!!
# Shared secret between backend and the privileged orchestration agent
AGENT_TOKEN=dev-agent-token-change-me

# Hard cap on a single install/update, in seconds (default 1h)
INSTALL_TIMEOUT=3600

# Host port pool for game servers
PORT_POOL_START=27015
PORT_POOL_END=27200

# Game-server base image tag (built from docker/gameserver)
GAMESERVER_IMAGE=steamcmd-manager/gameserver:latest

# Frontend
FRONTEND_ORIGIN=http://localhost:3000
# Backend is published on host port 8080 (maps to :8000 inside the container)
NEXT_PUBLIC_API_URL=http://localhost:8080
