# Copy to .env and adjust. Never commit real secrets.

# Postgres
POSTGRES_USER=steam
POSTGRES_PASSWORD=steam
POSTGRES_DB=steammanager

# Panel admin login (Phase 8 / auth)
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Secrets — generate strong random values for production
JWT_SECRET=dev-jwt-secret-change-me
# Must be at least 32 bytes; used to derive the Fernet key for Steam credentials
PANEL_SECRET=dev-panel-secret-change-me-32bytes!!
# Shared secret between backend and the privileged orchestration agent
AGENT_TOKEN=dev-agent-token-change-me

# Host port pool for game servers
PORT_POOL_START=27015
PORT_POOL_END=27200

# Game-server base image tag (built from docker/gameserver)
GAMESERVER_IMAGE=steamcmd-manager/gameserver:latest

# Frontend
FRONTEND_ORIGIN=http://localhost:3000
# Backend is published on host port 8080 (maps to :8000 inside the container)
NEXT_PUBLIC_API_URL=http://localhost:8080
